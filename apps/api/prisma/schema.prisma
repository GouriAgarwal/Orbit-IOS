generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  pending_review
  published
  rejected
  cancelled
  completed
}

enum EventFormat {
  in_person
  online
  hybrid
}

enum RegistrationMode {
  native
  external
}

model College {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  city      String?
  clubs     Club[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("colleges")
}

model Club {
  id                 String   @id @default(uuid()) @db.Uuid
  collegeId          String   @map("college_id") @db.Uuid
  name               String
  description        String   @default("")
  verificationStatus String   @default("pending") @map("verification_status")
  college            College  @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  events             Event[]
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([collegeId, name])
  @@map("clubs")
}

model Event {
  id                 String           @id @default(uuid()) @db.Uuid
  clubId             String           @map("club_id") @db.Uuid
  title              String
  description        String
  category           String
  format             EventFormat
  venue              String?
  startsAt           DateTime         @map("starts_at")
  endsAt             DateTime         @map("ends_at")
  registrationDeadline DateTime?       @map("registration_deadline")
  capacity           Int?
  status             EventStatus      @default(draft)
  registrationMode   RegistrationMode @default(native) @map("registration_mode")
  externalUrl        String?          @map("external_url")
  posterUrl          String?          @map("poster_url")
  club               Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([status, startsAt])
  @@index([category, startsAt])
  @@map("events")
}
