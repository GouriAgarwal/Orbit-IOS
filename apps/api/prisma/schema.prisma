generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  pending_review
  published
  rejected
  cancelled
  completed
}

enum EventFormat {
  in_person
  online
  hybrid
}

enum RegistrationMode {
  native
  external
}

enum AccountStatus {
  active
  suspended
}

enum ProfileVisibility {
  campus
  public
  private
}

enum ClubMemberRole {
  owner
  manager
  editor
}

enum ClubMemberStatus {
  invited
  active
  suspended
}

enum RegistrationStatus {
  registered
  waitlisted
  cancelled
  attended
  no_show
}

enum TeamStatus {
  recruiting
  full
  closed
  locked
}

enum TeamMemberStatus {
  active
  left
}

enum TeamRequestStatus {
  pending
  accepted
  declined
}

enum ReportTargetType {
  user
  event
  team
  club
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum ConnectionStatus {
  pending
  accepted
  declined
  cancelled
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  emailNormalized     String              @unique @map("email_normalized")
  passwordHash        String              @map("password_hash")
  accountStatus       AccountStatus       @default(active) @map("account_status")
  studentProfile      StudentProfile?
  sessions            Session[]
  clubMemberships     ClubMembership[]
  registrations       Registration[]
  ownedTeams          Team[]              @relation("TeamOwner")
  teamMemberships     TeamMembership[]
  teamRequests        TeamRequest[] @relation("TeamRequestRecipient")
  teamRequestInitiations TeamRequest[] @relation("TeamRequestInitiator")
  blocksMade          UserBlock[]         @relation("BlocksMade")
  blocksReceived      UserBlock[]         @relation("BlocksReceived")
  reports             Report[]
  savedEvents         SavedEvent[]
  connectionsSent     ConnectionRequest[] @relation("ConnectionSender")
  connectionsReceived ConnectionRequest[] @relation("ConnectionRecipient")
  notifications       Notification[]
  eventReviews        EventReview[]       @relation("EventReviewAuthor")
  eventMessages       EventMessage[]      @relation("EventMessageSender")
  clubVerificationRequests ClubVerificationRequest[] @relation("ClubVerificationApplicant")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  deviceDescription String?   @map("device_description")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model StudentProfile {
  userId       String            @id @map("user_id") @db.Uuid
  displayName  String            @map("display_name")
  collegeId    String?           @map("college_id") @db.Uuid
  course       String?
  year         Int?
  bio          String            @default("")
  visibility   ProfileVisibility @default(campus)
  skills       String[]          @default([])
  interests    String[]          @default([])
  projects     Project[]
  portfolioUrl String?           @map("portfolio_url")
  achievements String[]          @default([])
  college      College?          @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("student_profiles")
}

model College {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  city      String?
  clubs     Club[]
  students  StudentProfile[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("colleges")
}

model Club {
  id                 String           @id @default(uuid()) @db.Uuid
  collegeId          String           @map("college_id") @db.Uuid
  name               String
  description        String           @default("")
  verificationStatus String           @default("pending") @map("verification_status")
  college            College          @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  events             Event[]
  memberships        ClubMembership[]
  verificationRequest ClubVerificationRequest?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([collegeId, name])
  @@map("clubs")
}

model ClubVerificationRequest {
  id           String   @id @default(uuid()) @db.Uuid
  clubId       String   @unique @map("club_id") @db.Uuid
  applicantId  String   @map("applicant_id") @db.Uuid
  proofUrl     String   @map("proof_url")
  proofNotes   String   @map("proof_notes")
  status       String   @default("pending")
  submittedAt  DateTime @default(now()) @map("submitted_at")
  eligibleAt   DateTime @map("eligible_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?  @map("review_note")
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  applicant    User     @relation("ClubVerificationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([status, eligibleAt])
  @@index([applicantId, submittedAt])
  @@map("club_verification_requests")
}

model ClubMembership {
  id        String           @id @default(uuid()) @db.Uuid
  clubId    String           @map("club_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      ClubMemberRole   @default(editor)
  status    ClubMemberStatus @default(active)
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([clubId, userId])
  @@index([userId, status])
  @@map("club_memberships")
}

model Event {
  id                   String           @id @default(uuid()) @db.Uuid
  clubId               String           @map("club_id") @db.Uuid
  title                String
  description          String
  category             String
  format               EventFormat
  venue                String?
  startsAt             DateTime         @map("starts_at")
  endsAt               DateTime         @map("ends_at")
  registrationDeadline DateTime?        @map("registration_deadline")
  capacity             Int?
  minStudentsPerTeam   Int              @default(1) @map("min_students_per_team")
  maxStudentsPerTeam   Int              @default(1) @map("max_students_per_team")
  status               EventStatus      @default(draft)
  registrationMode     RegistrationMode @default(native) @map("registration_mode")
  externalUrl          String?          @map("external_url")
  posterUrl            String?          @map("poster_url")
  club                 Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  registrations        Registration[]
  savedBy              SavedEvent[]
  reviews              EventReview[]
  messages             EventMessage[]
  teams                Team[]
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([status, startsAt])
  @@index([category, startsAt])
  @@map("events")
}

model Registration {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  status       RegistrationStatus @default(registered)
  registeredAt DateTime           @default(now()) @map("registered_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student      User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([eventId, studentId])
  @@index([eventId, status, registeredAt])
  @@index([studentId, status, registeredAt])
  @@map("registrations")
}

model Project {
  id          String            @id @default(uuid()) @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  title       String
  description String            @default("")
  url         String?
  visibility  ProfileVisibility @default(campus)
  student     StudentProfile    @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([studentId])
  @@map("projects")
}

model Team {
  id           String           @id @default(uuid()) @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  eventId      String?          @map("event_id") @db.Uuid
  name         String
  goal         String
  description  String           @default("")
  skillsNeeded String[]         @default([]) @map("skills_needed")
  maxMembers   Int              @default(4) @map("max_members")
  status       TeamStatus       @default(recruiting)
  owner        User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  memberships  TeamMembership[]
  requests     TeamRequest[]
  roles        TeamRole[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([eventId, status])
  @@map("teams")
}

model TeamRole {
  id             String        @id @default(uuid()) @db.Uuid
  teamId         String        @map("team_id") @db.Uuid
  title          String
  description    String        @default("")
  requiredSkills String[]      @default([]) @map("required_skills")
  openings       Int           @default(1)
  filled         Int           @default(0)
  isOpen         Boolean       @default(true) @map("is_open")
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requests       TeamRequest[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([teamId, isOpen])
  @@map("team_roles")
}

model TeamMembership {
  id        String           @id @default(uuid()) @db.Uuid
  teamId    String           @map("team_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    TeamMemberStatus @default(active)
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([teamId, studentId])
  @@index([studentId, status])
  @@map("team_memberships")
}

model TeamRequest {
  id        String            @id @default(uuid()) @db.Uuid
  teamId    String            @map("team_id") @db.Uuid
  studentId String            @map("student_id") @db.Uuid
  roleId    String?           @map("role_id") @db.Uuid
  initiatorId String          @map("initiator_id") @db.Uuid
  message   String            @default("")
  status    TeamRequestStatus @default(pending)
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  student   User              @relation("TeamRequestRecipient", fields: [studentId], references: [id], onDelete: Cascade)
  initiator User              @relation("TeamRequestInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([teamId, studentId])
  @@index([studentId, status])
  @@map("team_requests")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  reason     String
  details    String           @default("")
  status     ReportStatus     @default(open)
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model SavedEvent {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  savedAt   DateTime @default(now()) @map("saved_at")
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([studentId, eventId])
  @@index([studentId, savedAt])
  @@map("saved_events")
}

model EventReview {
  id                  String   @id @default(uuid()) @db.Uuid
  eventId             String   @map("event_id") @db.Uuid
  authorId            String   @map("author_id") @db.Uuid
  rating              Int
  body                String
  organizerReply      String?  @map("organizer_reply")
  organizerRepliedAt  DateTime? @map("organizer_replied_at")
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author              User     @relation("EventReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([eventId, authorId])
  @@index([eventId, createdAt])
  @@map("event_reviews")
}

model EventMessage {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender    User     @relation("EventMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventId, createdAt])
  @@map("event_messages")
}

model ConnectionRequest {
  id          String           @id @default(uuid()) @db.Uuid
  senderId    String           @map("sender_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  status      ConnectionStatus @default(pending)
  sender      User             @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@map("connection_requests")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
